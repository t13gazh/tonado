# Tonado — minimal sudo grants for system management.
# Deployed to /etc/sudoers.d/tonado by install.sh.
# EDIT WITH CAUTION. Always `visudo -cf` before committing changes.
#
# Only the commands below are allowed without password. We prefer exact
# argv and avoid wildcards; the one exception (setup-ap.sh, see below)
# carries variable WiFi credentials and is a script that never spawns a
# shell, so the wildcard cannot expand into anything but literal argv.
#
# %TONADO_USER% is replaced by install.sh with the actual install user
# (from $SUDO_USER, default "pi"). On Raspberry Pi OS Bookworm, the real
# binaries live under /usr/bin and /usr/sbin — /bin and /sbin are symlinks.
# sudoers does not resolve symlinks, so we use the canonical /usr/... paths.

%TONADO_USER% ALL=(root) NOPASSWD: /usr/bin/systemctl restart tonado.service
%TONADO_USER% ALL=(root) NOPASSWD: /usr/sbin/shutdown -h now
%TONADO_USER% ALL=(root) NOPASSWD: /usr/sbin/reboot

# Setup-AP teardown (called once from /api/setup/confirm-complete).
# Stopping the unit runs its ExecStop (setup-ap.sh stop), which hands wlan0
# back to NetworkManager — so no separate unmanaged-conf removal is needed.
%TONADO_USER% ALL=(root) NOPASSWD: /usr/bin/systemctl stop tonado-ap.service
%TONADO_USER% ALL=(root) NOPASSWD: /usr/bin/systemctl disable tonado-ap.service

# Recovery AP: CaptivePortalService (runs as the unprivileged tonado user)
# delegates every wlan0 mutation to setup-ap.sh via sudo. SSID/PSK are
# variable, hence the trailing wildcard — setup-ap.sh never invokes a shell,
# so the args remain literal argv.
%TONADO_USER% ALL=(root) NOPASSWD: /opt/tonado/system/setup-ap.sh start secured *
%TONADO_USER% ALL=(root) NOPASSWD: /opt/tonado/system/setup-ap.sh stop

Defaults!/usr/bin/systemctl !setenv
Defaults!/usr/sbin/shutdown !setenv
Defaults!/usr/sbin/reboot !setenv
Defaults!/opt/tonado/system/setup-ap.sh !setenv
